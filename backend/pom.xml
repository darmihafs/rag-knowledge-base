<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Spring Boot 3.x 最后一条主线；满足 3.2+ 要求 -->
        <version>3.5.16</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.bishe</groupId>
    <artifactId>kb-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>kb-backend</name>
    <description>私有知识库问答系统（RAG）后端</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 版本均已核对 Maven 中央仓库（2026-10） -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <langchain4j.version>1.22.0</langchain4j.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <tika.version>4.1.0</tika.version>
        <jjwt.version>0.12.6</jjwt.version>

        <!-- 评测跑批（第九阶段）默认被排除：它要真实调用 embedding 接口、耗时数分钟且依赖密钥。
             用 -P benchmark 时才纳入，同时把 kb.benchmark 系统属性透传进 fork 出的测试 JVM。 -->
        <benchmark.exclude.pattern>**/benchmark/**</benchmark.exclude.pattern>
        <kb.benchmark>false</kb.benchmark>
        <benchmark.out>../docs/evaluation</benchmark.out>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- LangChain4j BOM：统一管理 langchain4j 全家桶版本 -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web / 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MyBatis-Plus：Spring Boot 3 专用 starter（注意 artifactId 是 spring-boot3，不是 boot-starter）
             3.5.17 起 IService / ServiceImpl 已从 extension 迁到 mybatis-plus-spring 模块，
             导入包名为 com.baomidou.mybatisplus.spring.service[.impl]，网上旧教程的 extension.service 会编译失败 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- 3.5.9 起 JSqlParser 支持被拆出：分页、BlockAttack 等内部拦截器必须有它才生效 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动：版本由 Spring Boot parent 统一管理（com.mysql:mysql-connector-j） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============ 认证与鉴权（第七阶段） ============ -->
        <!-- JWT：jjwt 0.12.x 三件套。api 编译期用，impl/jackson 运行期用（离线仓库已缓存 0.12.6） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- 只用 BCryptPasswordEncoder 做密码哈希，不引入 spring-boot-starter-security，
             避免它自动装配整套过滤器链与我们的手写拦截器冲突。
             显式锁 6.3.10：Boot 默认会解析到未缓存的 6.5.x，离线构建会失败 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
            <version>6.3.10</version>
        </dependency>

        <!-- RAG 核心：文档解析 -> 分块 -> 向量化 -> 检索 -> 生成 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>
        <!-- OpenAI 兼容协议：可对接 DashScope(通义) / DeepSeek / 本地 vLLM、Ollama 的 /v1 接口 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
        </dependency>
        <!-- 向量库（先留一个轻量的内存/本地方案，后续可换成 milvus / qdrant / pgvector）
             需要时打开：
             <dependency>
               <groupId>dev.langchain4j</groupId>
               <artifactId>langchain4j-milvus</artifactId>
             </dependency>
        -->

        <!-- 文档解析：PDF 精细控制用 PDFBox，多格式（doc/docx/ppt/扫描 OCR 等）用 Tika -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <!-- 4.x 起该聚合包只发布 pom（无 jar），依赖它把全部解析器模块带进来 -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>${tika.version}</version>
            <type>pom</type>
        </dependency>

        <!-- 工具类 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 仅测试用：内存库跑上传解析链路，避免污染开发库 kb_rag -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>kb-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- 存量单元/集成测试与评测跑批的隔离闸门，见上方 benchmark.exclude.pattern -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>${benchmark.exclude.pattern}</exclude>
                    </excludes>
                    <systemPropertyVariables>
                        <kb.benchmark>${kb.benchmark}</kb.benchmark>
                        <kb.benchmark.out>${benchmark.out}</kb.benchmark.out>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 第九阶段：RAG 检索策略消融实验 + 切片窗口敏感度实验
             mvn test -P benchmark -Dtest=RetrievalBenchmarkTest -->
        <profile>
            <id>benchmark</id>
            <properties>
                <!-- 清掉默认排除：换成一个不存在的路径，等价于不排除任何类 -->
                <benchmark.exclude.pattern>**/__BenchmarkIncludeAll__.java</benchmark.exclude.pattern>
                <kb.benchmark>true</kb.benchmark>
            </properties>
        </profile>
    </profiles>
</project>
