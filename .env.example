# ============================================================================
# 复制成 .env 再填值：cp .env.example .env
# .env 已被 .gitignore 忽略，禁止把真实密钥提交进仓库。
# ============================================================================

# ---- MySQL ----
# compose 会用它初始化 root 密码，必填
MYSQL_PASSWORD=change-me-strong-password
# 宿主机映射端口；想直连容器里的 MySQL 就用这个端口，避开本机 3306 冲突
MYSQL_EXPOSE_PORT=13306

# ---- 认证 ----
# JWT HS256+ 签名密钥，至少 32 字节；缺失时后端启动即失败（不会退化成默认密钥）
# 生成一条：openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_EXPIRE_MINUTES=720

# ---- 大模型（阿里云百炼 DashScope 兼容模式）----
# 留空也能启动：此时问答走 mock 分支（用检索结果拼演示回答），但语义召回不可用
RAG_API_KEY=
RAG_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_CHAT_MODEL=qwen-plus
RAG_EMBEDDING_MODEL=text-embedding-v3
# false = 只解析/分块/落库，不调 embedding 接口（离线演示可设 false）
RAG_EMBEDDING_ENABLED=true
# true = 不调大模型，用检索结果拼回答并逐字推送（仅排查 SSE 链路用）
RAG_MOCK_ENABLED=false

# ---- 检索策略 ----
# fulltext = MATCH ... AGAINST 走 ngram 全文索引（默认，快一个数量级）
# like     = 逐词 LIKE 全表扫描，给不支持 MATCH 的库或压测对照组用
RAG_LEXICAL_MODE=fulltext
# 问题向量化超时秒数：检索慢就是体验事故，比对话模型的 60 秒紧得多
RAG_EMBEDDING_TIMEOUT_SECONDS=20
# 问题向量缓存条数（同模型同问题的向量确定，重复提问不再发远程调用）；0 = 关闭
RAG_EMBEDDING_QUERY_CACHE_SIZE=512

# ---- 前端 ----
WEB_PORT=5080
